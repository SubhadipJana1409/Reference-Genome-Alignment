# ── Reference data (large files — see data/reference/README.md to download) ──
data/reference/chr22.fa
data/reference/chr22.fa.gz
data/reference/*.gtf
data/reference/*.gtf.gz
data/reference/*.fa
data/reference/*.fa.gz

# ── FASTQ reads (regenerate with scripts/download_data.sh) ──────────────────
data/wgs/
data/rnaseq/

# ── Large binary alignment outputs (regenerate with alignment_benchmark.py) ──
results/alignments/**/*.bam
results/alignments/**/*.bam.bai
results/indexes/bowtie2/*.bt2
results/indexes/star/Genome
results/indexes/star/SA
results/indexes/star/SAindex
results/indexes/star/chr*.txt
results/indexes/star/exon*.tab
results/indexes/star/genomeParameters.txt

# STAR output BAMs (text logs, SJ.out.tab, Log.* ARE committed)
results/star_1pass/**/*.bam
results/star_1pass/**/*.bam.bai
results/star_2pass/**/*.bam
results/star_2pass/**/*.bam.bai
results/star_2pass/**/_STARgenome/Genome
results/star_2pass/**/_STARgenome/SA
results/star_2pass/**/_STARgenome/SAindex

# ── Python / Jupyter ─────────────────────────────────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/

# ── What IS committed (for clarity) ──────────────────────────────────────────
# data/reference/README.md                    ✓ download instructions
# scripts/download_data.sh                    ✓ data download script
# scripts/simulate_reference.py              ✓ synthetic reference generator
# scripts/alignment_benchmark.py             ✓ full pipeline
# notebooks/Day2_Alignment_Benchmark.ipynb   ✓ analysis notebook
# results/flagstats/*.txt                    ✓ samtools flagstat outputs
# results/star_1pass/*/SJ.out.tab            ✓ splice junction tables
# results/star_1pass/*/Log.final.out         ✓ STAR alignment summary logs
# results/star_2pass/*/SJ.out.tab            ✓ splice junction tables
# results/star_2pass/*/_STARpass1/SJ.out.tab ✓ pass-1 internal junction table
# results/star_2pass/*/_STARgenome/sjdb*.tab ✓ merged junction lists
# results/junctions/*.tsv                    ✓ junction comparison analysis
# results/benchmarks/*.tsv                   ✓ benchmark tables
# results/benchmarks/*.png                   ✓ figures

# Insert size raw data (large — regenerated by pipeline)
results/benchmarks/insert_sizes_raw.tsv
